# Kaizy Environment Variables

# Supabase (Database & Realtime)
# Get these from https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Mapbox (Maps & Reverse Geocoding)
# Get a free public token from https://mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1Ijoia2FpenkiLCJhIjoiY2x6c2FmZXJ0MDAwMDJqcTE4bnNkOGpxayJ9.dev

# Authentication
JWT_SECRET=kaizy-development-secret-key-32-characters-minimum

# Razorpay (Optional - for payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Web Push Notifications (Optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@kaizy.in
